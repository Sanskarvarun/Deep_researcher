# DeepResearcher Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# === LLM PROVIDERS ===
# Primary: Google Gemini (free key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here
# 'latest' aliases track the current stable models, so pinned names can't rot
GOOGLE_MODEL=gemini-flash-latest
GOOGLE_TEMPERATURE=0.1
GOOGLE_MAX_TOKENS=4096

# Fallback: OpenRouter (free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TEMPERATURE=0.1

# Optional: Groq (free key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# Provider order: try primary first, then fallbacks on failure
LLM_PRIMARY=gemini
LLM_FALLBACKS=["openrouter", "groq"]

# HuggingFace Embeddings (Required for HF Inference API)
# Options: "huggingface" (default), "local", "gemini"
# Get your token from https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_token_here
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
USE_LOCAL_EMBEDDINGS=false

# Gemini Embeddings (optional, if EMBEDDING_PROVIDER=gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Qdrant Vector Database (Required)
# For local: qdrant_url=http://localhost:6333 (no api key needed)
# For cloud: Get from https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_PREFER_GRPC=false

# Cohere Reranking (Optional - we use local by default)
# Get your API key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
USE_LOCAL_RERANKER=true
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-large

# Retrieval Settings
TOP_K=10
RERANK_TOP_K=5
SCORE_THRESHOLD=0.5
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

# Chunking Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=100
CHUNKING_STRATEGY=recursive
SEMANTIC_CHUNKING=false

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
ENABLE_CACHE=true

# Observability
# LangSmith (primary tracing backend via OTLP - no local service needed)
# Get from https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearcher
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Phoenix (optional local fallback - only used if LangSmith is disabled)
# Run with: docker run -p 6006:6006 arizephoenix/phoenix
PHOENIX_URL=http://localhost:6006

# OpenTelemetry tracing (LangSmith OTLP -> Phoenix -> console)
ENABLE_TRACING=true
METRICS_ENABLED=true

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
ENABLE_RATE_LIMIT=true

# API security
# When REQUIRE_AUTH=true, every /api/* request must send the key via
# `X-API-Key: <key>` or `Authorization: Bearer <key>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
REQUIRE_AUTH=true
MAX_REQUEST_BYTES=1048576
# JSON list of peers whose X-Forwarded-For header is trusted, e.g.
# TRUSTED_PROXIES=["10.0.0.1"] . Leave empty unless running behind a reverse
# proxy / load balancer you control.
TRUSTED_PROXIES=[]
# Optional root directory that API ingestion paths must stay inside.
# Leave empty to allow any readable path (traversal is still rejected).
INGEST_ROOT=

# Resilience (external services: LLM, Qdrant, embeddings)
# Per-request ceiling for provider calls; prevents a stalled provider from
# blocking a request forever (retries/breakers can only fire after a failure).
LLM_TIMEOUT_SECONDS=60
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30.0
CIRCUIT_HALF_OPEN_MAX_CALLS=1

# Graceful degradation: after every full-size model fails, retry with the
# smaller model on the same provider (Gemini flash -> flash-lite, etc.).
DEGRADED_MODEL_ENABLED=true
GOOGLE_DEGRADED_MODEL=gemini-flash-lite-latest
OPENROUTER_DEGRADED_MODEL=meta-llama/llama-3.1-8b-instruct:free
GROQ_DEGRADED_MODEL=llama-3.1-8b-instant

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=[".pdf", ".md", ".txt", ".html", ".htm"]

# Evaluation (Optional)
RAGAS_APP_TOKEN=
EVALUATION_DATASET_PATH=data/eval/golden_set.json

# Search API Keys (for WebSearchTool)
# Get your SERP API key from https://serpapi.com/
SERPAPI_KEY=
# Get your Brave Search API key from https://brave.com/search/api/
BRAVE_SEARCH_KEY=
# Get your Google Custom Search API key and CX from https://programmablesearchengine.google.com/
GOOGLE_SEARCH_KEY=
GOOGLE_SEARCH_CX=

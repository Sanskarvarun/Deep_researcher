# DeepResearcher Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# === LLM PROVIDERS ===
# Primary: Google Gemini (free key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.5-flash-lite
GOOGLE_TEMPERATURE=0.1
GOOGLE_MAX_TOKENS=4096

# Fallback: OpenRouter (free key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_TEMPERATURE=0.1

# Optional: Groq (free key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# Provider order: try primary first, then fallbacks on failure
LLM_PRIMARY=gemini
LLM_FALLBACKS=["openrouter", "groq"]

# HuggingFace Embeddings (Required for HF Inference API)
# Options: "huggingface" (default), "local", "gemini"
# Get your token from https://huggingface.co/settings/tokens
HF_API_TOKEN=your_hf_token_here
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024
USE_LOCAL_EMBEDDINGS=false

# Gemini Embeddings (optional, if EMBEDDING_PROVIDER=gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Qdrant Vector Database (Required)
# For local: qdrant_url=http://localhost:6333 (no api key needed)
# For cloud: Get from https://cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_PREFER_GRPC=false

# Cohere Reranking (Optional - we use local by default)
# Get your API key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
RERANK_MODEL=rerank-english-v3.0
USE_LOCAL_RERANKER=true
LOCAL_RERANKER_MODEL=BAAI/bge-reranker-large

# Retrieval Settings
TOP_K=10
RERANK_TOP_K=5
SCORE_THRESHOLD=0.5
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

# Chunking Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=100
CHUNKING_STRATEGY=recursive
SEMANTIC_CHUNKING=false

# Redis Cache (Optional)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
ENABLE_CACHE=true

# Observability
# LangSmith (Optional - for tracing)
# Get from https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepresearcher
LANGSMITH_TRACING=false

# Phoenix (Local tracing - no API key needed)
# Run with: docker run -p 6006:6006 arizephoenix/phoenix
PHOENIX_URL=http://localhost:6006

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_EXTENSIONS=[".pdf", ".md", ".txt", ".html", ".htm"]

# Evaluation (Optional)
RAGAS_APP_TOKEN=
EVALUATION_DATASET_PATH=data/eval/golden_set.json
